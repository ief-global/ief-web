# ── IEF website .gitignore ──────────────────────────────────────────
# Minimal, project-specific. The site is static HTML + a small Python
# compiler; anything not listed here is meant to be committed.

# Build output (regenerated by html/compile_site.py — never edit/commit)
dist/

# Secrets & credentials (Cloudflare, Wrangler) — never commit
.env
.envrc
.dev.vars
.wrangler/

# Tailscale runtime state (machine-specific, contains private keys)
ts-state/

# Python bytecode
__pycache__/
*.py[cod]

# Node (Tailwind CLI build, planned — see docs/BLUEPRINT §4 Phase A)
node_modules/

# Local Claude/Cowork scratch files (session-scoped, not source)
# NOTE: WORKFLOW.md is intentionally NOT ignored — it is a canonical repo doc.
IEF-HANDOFF.md
PROJECT-*.md
.claude/

# Editors & workspaces
.vscode/
*.code-workspace

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
